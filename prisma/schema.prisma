generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                  @id @default(cuid())
  username              String                  @unique
  password              String
  role                  Role
  clubId                String?                 @unique
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  activityLogs          ActivityLog[]
  notifications         Notification[]
  transferWindowHistory TransferWindowHistory[]
  transfersInitiated    Transfer[]              @relation("TransferInitiatedBy")
  transfersResponded    Transfer[]              @relation("TransferRespondedBy")
  club                  Club?                   @relation("UserManagesClub", fields: [clubId], references: [id])
  auctionsCreated       Auction[]               @relation("AuctionsCreated")
  auctionBids           AuctionBid[]
  posts                 Post[]
  postComments          PostComment[]
  postReactions         PostReaction[]
  sentMessages          DirectMessage[]         @relation("SentMessages")
  receivedMessages      DirectMessage[]         @relation("ReceivedMessages")

  @@index([role])
}

model CompetitionSeason {
  id        String                  @id @default(cuid())
  name      String                  @unique
  status    CompetitionSeasonStatus @default(DRAFT)
  format    MatchFormat             @default(DOUBLE_ROUND_ROBIN)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  seasons   Season[]
  matches   Match[]
  totws     TeamOfTheWeek[]
  globalTotws GlobalTeamOfTheWeek[]

  @@index([status])
}

model League {
  id        String   @id @default(cuid())
  name      String   @unique
  country   String
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clubs     Club[]
  seasons   Season[]
  matches   Match[]
  totws     TeamOfTheWeek[]
  globalTotwPlayers GlobalTotwPlayer[]
  throneCups ThroneCup[]
}

model Club {
  id                                     String                  @id @default(cuid())
  name                                   String
  logo                                   String?
  leagueId                               String
  managerId                              String?                 @unique
  createdAt                              DateTime                @default(now())
  updatedAt                              DateTime                @updatedAt
  budget                                 Decimal                 @default(0) @db.Decimal(14, 2)
  aiScoutEnabled                         Boolean                 @default(false)
  aiScoutTier                            String                  @default("FREE")

  league                                 League                  @relation(fields: [leagueId], references: [id])
  seasonClassifications                  SeasonClassification[]
  powerRating                            ClubPowerRating?
  budgetTransactions                     ClubBudgetTransaction[]
  players                                Player[]
  PlayerLoan_PlayerLoan_fromClubIdToClub PlayerLoan[]            @relation("PlayerLoan_fromClubIdToClub")
  PlayerLoan_PlayerLoan_toClubIdToClub   PlayerLoan[]            @relation("PlayerLoan_toClubIdToClub")
  transfersOut                           Transfer[]              @relation("TransferFromClub")
  transfersIn                            Transfer[]              @relation("TransferToClub")
  manager                                User?                   @relation("UserManagesClub")
  homeMatches                            Match[]                 @relation("HomeMatches")
  awayMatches                            Match[]                 @relation("AwayMatches")
  wonAuctions                            Auction[]               @relation("WinningClubAuctions")
  auctionBids                            AuctionBid[]
  posts                                  Post[]
  postComments                           PostComment[]
  matchEvents                            MatchEvent[]
  totwPlayers                            TotwPlayer[]
  globalTotwPlayers                      GlobalTotwPlayer[]
  throneCupHomeMatches                   ThroneCupMatch[]        @relation("ThroneCupHomeMatches")
  throneCupAwayMatches                   ThroneCupMatch[]        @relation("ThroneCupAwayMatches")
  throneCupWinnerMatches                 ThroneCupMatch[]        @relation("ThroneCupWinnerMatches")
  throneCupTitles                        ThroneCup[]             @relation("ThroneCupChampion")

  @@unique([name, leagueId])
  @@index([leagueId])
}

model Player {
  id                 String                  @id @default(uuid())
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  dateOfBirth        DateTime?
  fullName           String
  marketValue        Decimal?               @db.Decimal(12, 2)
  nationality        String
  overallRating      Int?
  photo              String?
  playerId           Int                     @unique @default(autoincrement())
  pmbClubId          String?
  position           String
  realClub           String
  status             PlayerStatus            @default(AVAILABLE)
  // ── Botola Pro Contract Fields ──────────────────────────────────────────
  seasonSalary         Decimal                 @default(0) @db.Decimal(14, 2)
  primeSignature       Decimal                 @default(0) @db.Decimal(14, 2)
  contractSeasonsLeft  Int                     @default(1)
  squadRole            String                  @default("IMPORTANT")
  releaseClause        Decimal?                @db.Decimal(14, 2)
  contractSatisfaction Int                     @default(85)
  lastNegotiatedAt     DateTime?
  // ── Expired Contract & Admin Custody Fields ─────────────────────────
  isFreeAgentMarket    Boolean                 @default(false)
  expiredFromClubId    String?
  expiredFromClubName  String?
  contractExpiredAt    DateTime?
  adminCustodyStatus   String?                 // "PENDING_ADMIN_DECISION" | "AUCTIONED" | "FREE_AGENT_MARKET"
  failedFreeAgentClubIds String?               // Comma-separated list of club IDs that exhausted their 1 chance
  budgetTransactions ClubBudgetTransaction[]
  pmbClub            Club?                  @relation(fields: [pmbClubId], references: [id])
  PlayerLoan         PlayerLoan[]
  transfers          Transfer[]
  auctions           Auction[]
  motmMatches        Match[]                 @relation("PlayerMotmMatches")
  matchEvents        MatchEvent[]            @relation("PlayerMatchEvents")
  assistedEvents     MatchEvent[]            @relation("PlayerAssists")
  totwSelections     TotwPlayer[]
  globalTotwSelections GlobalTotwPlayer[]
  throneCupMotmMatches ThroneCupMatch[]      @relation("ThroneCupMotmMatches")
  throneCupEvents      ThroneCupMatchEvent[]

  @@index([fullName])
  @@index([position])
  @@index([realClub])
  @@index([nationality])
  @@index([status])
  @@index([pmbClubId])
}

model Transfer {
  id                   String                  @id @default(uuid())
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  completedAt          DateTime?
  currency             String                  @default("EUR")
  fee                  Decimal?                @db.Decimal(12, 2)
  fromClubId           String
  fromClubName         String
  initiatedByUserId    String
  notes                String?
  playerId             String
  playerName           String
  respondedAt          DateTime?
  respondedByUserId    String?
  season               String
  status               TransferStatus          @default(PENDING_SELLER_APPROVAL)
  toClubId             String
  toClubName           String
  type                 TransferType            @default(PERMANENT)
  durationDays         Int?
  swapPlayerName       String?
  swapPlayerId         String?
  agreedSalary         Decimal?                @db.Decimal(14, 2)
  agreedPrime          Decimal?                @db.Decimal(14, 2)
  agreedSeasons        Int?
  agreedRole           String?
  agreedReleaseClause  Decimal?                @db.Decimal(14, 2)
  budgetTransactions   ClubBudgetTransaction[]
  notifications        Notification[]
  PlayerLoan           PlayerLoan?
  fromClub             Club                    @relation("TransferFromClub", fields: [fromClubId], references: [id])
  initiatedBy          User                    @relation("TransferInitiatedBy", fields: [initiatedByUserId], references: [id])
  player               Player                  @relation(fields: [playerId], references: [id])
  respondedBy          User?                   @relation("TransferRespondedBy", fields: [respondedByUserId], references: [id])
  toClub               Club                    @relation("TransferToClub", fields: [toClubId], references: [id])

  @@index([playerId])
  @@index([fromClubId])
  @@index([toClubId])
  @@index([status])
  @@index([playerId, status])
}

model Notification {
  id         String           @id @default(uuid())
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  message    String
  read       Boolean          @default(false)
  transferId String?
  type       NotificationType
  userId     String
  transfer   Transfer?        @relation(fields: [transferId], references: [id])
  user       User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, read])
  @@index([transferId])
}

model ActivityLog {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  action      String
  actorUserId String?
  entityId    String?
  entityType  String?
  metadata    Json?
  actor       User?    @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
}

model TransferWindow {
  id        String   @id @default("singleton")
  isOpen    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model TransferWindowHistory {
  id              String               @id @default(uuid())
  previousIsOpen  Boolean
  newIsOpen       Boolean
  action          TransferWindowAction
  changedByUserId String
  createdAt       DateTime             @default(now())
  changedBy       User                 @relation(fields: [changedByUserId], references: [id])

  @@index([createdAt])
  @@index([changedByUserId])
}

model ClubBudgetTransaction {
  id           String                @id @default(uuid())
  clubId       String
  amount       Decimal               @db.Decimal(14, 2)
  balanceAfter Decimal               @db.Decimal(14, 2)
  type         BudgetTransactionType
  description  String?
  transferId   String?
  playerId     String?
  matchId      String?
  createdAt    DateTime              @default(now())

  club         Club                  @relation(fields: [clubId], references: [id])
  player       Player?               @relation(fields: [playerId], references: [id])
  transfer     Transfer?             @relation(fields: [transferId], references: [id])
  match        Match?                @relation(fields: [matchId], references: [id])

  @@index([clubId])
  @@index([clubId, createdAt])
  @@index([transferId])
  @@index([matchId])
}

model Season {
  id                  String                  @id @default(cuid())
  name                String
  leagueId            String
  startDate           DateTime?
  endDate             DateTime?
  status              SeasonStatus            @default(DRAFT)
  competitionSeasonId String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  league              League                  @relation(fields: [leagueId], references: [id])
  classifications     SeasonClassification[]
  competitionSeason   CompetitionSeason?      @relation(fields: [competitionSeasonId], references: [id])
  matches             Match[]
  totws               TeamOfTheWeek[]

  @@unique([leagueId, name])
  @@index([leagueId])
  @@index([status])
  @@index([competitionSeasonId])
}

model SeasonClassification {
  id             String   @id @default(cuid())
  seasonId       String
  clubId         String
  position       Int
  points         Int?
  played         Int?
  wins           Int?
  draws          Int?
  losses         Int?
  goalDifference Int?
  goalsFor       Int?
  goalsAgainst   Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  season         Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  club           Club     @relation(fields: [clubId], references: [id])

  @@unique([seasonId, clubId])
  @@unique([seasonId, position])
  @@index([seasonId])
  @@index([clubId])
}

model PlayerLoan {
  id                               String     @id
  playerId                         String
  fromClubId                       String
  toClubId                         String
  transferId                       String     @unique
  startDate                        DateTime
  endDate                          DateTime
  status                           LoanStatus @default(ACTIVE)
  createdAt                        DateTime   @default(now())
  updatedAt                        DateTime
  durationDays                     Int        @default(40)

  Club_PlayerLoan_fromClubIdToClub Club       @relation("PlayerLoan_fromClubIdToClub", fields: [fromClubId], references: [id])
  Player                           Player     @relation(fields: [playerId], references: [id])
  Club_PlayerLoan_toClubIdToClub   Club       @relation("PlayerLoan_toClubIdToClub", fields: [toClubId], references: [id])
  Transfer                         Transfer   @relation(fields: [transferId], references: [id])

  @@index([endDate])
  @@index([fromClubId])
  @@index([playerId])
  @@index([status])
  @@index([toClubId])
}
model Match {
  id                  String      @id @default(cuid())
  competitionSeasonId String
  seasonId            String
  leagueId            String
  matchday            Int
  homeClubId          String
  awayClubId          String
  homeGoals           Int?
  awayGoals           Int?
  status              MatchStatus @default(UPCOMING)
  playedAt            DateTime?
  manOfTheMatchId     String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  competitionSeason   CompetitionSeason      @relation(fields: [competitionSeasonId], references: [id])
  season              Season                 @relation(fields: [seasonId], references: [id])
  league              League                 @relation(fields: [leagueId], references: [id])
  homeClub            Club                   @relation("HomeMatches", fields: [homeClubId], references: [id])
  awayClub            Club                   @relation("AwayMatches", fields: [awayClubId], references: [id])
  manOfTheMatch       Player?                @relation("PlayerMotmMatches", fields: [manOfTheMatchId], references: [id])
  budgetTransactions  ClubBudgetTransaction[]
  events              MatchEvent[]

  @@index([competitionSeasonId])
  @@index([seasonId])
  @@index([leagueId])
  @@index([homeClubId])
  @@index([awayClubId])
  @@index([manOfTheMatchId])
  @@index([status])
  @@index([matchday])
  @@index([seasonId, matchday])
}

model ClubPowerRating {
  id            String   @id @default(cuid())
  clubId        String   @unique
  rating        Int      @default(1000)
  seasonsPlayed Int      @default(0)
  titles        Int      @default(0)
  topThree      Int      @default(0)
  topFive       Int      @default(0)
  updatedAt     DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id])

  @@index([rating])
}
enum Role {
  ADMINISTRATOR
  CLUB_MANAGER
}

enum PlayerStatus {
  AVAILABLE
  REGISTERED
}

enum TransferStatus {
  PENDING_SELLER_APPROVAL
  PENDING_PERSONAL_TERMS
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum TransferType {
  PERMANENT
  LOAN
  SWAP
  FREE_TRANSFER
}

enum TransferWindowAction {
  OPENED
  CLOSED
}

enum NotificationType {
  TRANSFER_REQUESTED
  TRANSFER_ACCEPTED
  TRANSFER_REJECTED
  TRANSFER_CANCELLED
  TRANSFER_COMPLETED
  TRANSFER_WINDOW_OPENED
  TRANSFER_WINDOW_CLOSED
  POST_COMMENT
  POST_REACTION
}

enum BudgetTransactionType {
  TRANSFER_IN
  TRANSFER_OUT
  ADMIN_ADJUSTMENT
  COMPETITION_REWARD
  AUCTION_WIN
  AUCTION_BID_REFUND
  TRANSFER_REFUND
  PRIME_DE_SIGNATURE
  SEASON_SALARY_PAYOUT
  RELEASE_CLAUSE_PAYOUT
  CONTRACT_TERMINATION_PAYOUT
}

enum AuctionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

model Auction {
  id                  String        @id @default(cuid())
  playerId            String
  adminUserId         String
  startingPrice       Decimal       @db.Decimal(14, 2)
  minIncrement        Decimal       @default(500000) @db.Decimal(14, 2)
  currentBid          Decimal       @db.Decimal(14, 2)
  currentWinnerClubId String?
  status              AuctionStatus @default(ACTIVE)
  personalTermsAgreed Boolean       @default(false)
  adminApproved       Boolean       @default(false)
  agreedSalary        Decimal?      @db.Decimal(14, 2)
  agreedPrime         Decimal?      @db.Decimal(14, 2)
  agreedSeasons       Int?
  agreedRole          String?
  agreedReleaseClause Decimal?      @db.Decimal(14, 2)
  startsAt            DateTime      @default(now())
  expiresAt           DateTime
  completedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  player            Player       @relation(fields: [playerId], references: [id])
  admin             User         @relation("AuctionsCreated", fields: [adminUserId], references: [id])
  currentWinnerClub Club?        @relation("WinningClubAuctions", fields: [currentWinnerClubId], references: [id])
  bids              AuctionBid[]

  @@index([status])
  @@index([expiresAt])
  @@index([playerId])
  @@index([currentWinnerClubId])
}

model AuctionBid {
  id        String   @id @default(cuid())
  auctionId String
  clubId    String
  userId    String
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([auctionId, createdAt])
  @@index([clubId])
}

enum LoanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SeasonStatus {
  DRAFT
  ACTIVE
  FINISHED
}

enum CompetitionSeasonStatus {
  DRAFT
  ACTIVE
  FINISHED
}

enum MatchFormat {
  SINGLE_ROUND_ROBIN
  DOUBLE_ROUND_ROBIN
}

enum MatchStatus {
  UPCOMING
  COMPLETED
}

enum PostTag {
  STATEMENT
  TRANSFER
  BANTER
  VICTORY
  GENERAL
}

model Post {
  id        String         @id @default(cuid())
  content   String         @db.Text
  tag       PostTag        @default(GENERAL)
  mediaUrl  String?
  userId    String
  clubId    String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  club      Club?          @relation(fields: [clubId], references: [id], onDelete: SetNull)
  comments  PostComment[]
  reactions PostReaction[]

  @@index([createdAt])
  @@index([userId])
  @@index([clubId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  clubId    String?
  content   String   @db.Text
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  club      Club?    @relation(fields: [clubId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
}

model PostReaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  reaction  String   // "GOAL", "FIRE", "TROPHY", "CLAP", "POPCORN"
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, reaction])
  @@index([postId])
}

model DirectMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String   @db.Text
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, read])
}

enum MatchEventType {
  GOAL
  ASSIST
  YELLOW_CARD
  RED_CARD
  OWN_GOAL
}

model MatchEvent {
  id             String         @id @default(cuid())
  matchId        String
  clubId         String
  playerId       String
  assistPlayerId String?
  type           MatchEventType @default(GOAL)
  minute         Int?
  createdAt      DateTime       @default(now())

  match          Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  club           Club           @relation(fields: [clubId], references: [id])
  player         Player         @relation("PlayerMatchEvents", fields: [playerId], references: [id])
  assistPlayer   Player?        @relation("PlayerAssists", fields: [assistPlayerId], references: [id])

  @@index([matchId])
  @@index([playerId])
  @@index([clubId])
  @@index([assistPlayerId])
}

model TeamOfTheWeek {
  id                  String            @id @default(cuid())
  competitionSeasonId String
  seasonId            String?
  leagueId            String?
  matchday            Int
  formation           String            @default("4-3-3")
  isPublished         Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  players             TotwPlayer[]
  competitionSeason   CompetitionSeason @relation(fields: [competitionSeasonId], references: [id], onDelete: Cascade)
  season              Season?           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  league              League?           @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([competitionSeasonId, leagueId, matchday])
  @@index([competitionSeasonId])
  @@index([leagueId])
  @@index([matchday])
}

model TotwPlayer {
  id                String        @id @default(cuid())
  totwId            String
  playerId          String
  clubId            String
  position          String        // "GK", "LB", "CB1", "CB2", "RB", "DMF", "CMF", "AMF", "LWF", "CF", "RWF"
  ratingBoost       Int           @default(2)
  goalsInMatchday   Int           @default(0)
  assistsInMatchday Int           @default(0)
  isMotm            Boolean       @default(false)
  createdAt         DateTime      @default(now())

  totw              TeamOfTheWeek @relation(fields: [totwId], references: [id], onDelete: Cascade)
  player            Player        @relation(fields: [playerId], references: [id])
  club              Club          @relation(fields: [clubId], references: [id])

  @@unique([totwId, position])
  @@index([totwId])
  @@index([playerId])
  @@index([clubId])
}

model GlobalTeamOfTheWeek {
  id                  String              @id @default(cuid())
  competitionSeasonId String?
  edition             Int                 @unique
  title               String              @default("Global All-Stars")
  formation           String              @default("4-3-3")
  leagueRounds        Json                // Array of { leagueId: string, leagueName: string, matchday: number }
  isPublished         Boolean             @default(true)
  firstPlacePlayerId  String?
  secondPlacePlayerId String?
  thirdPlacePlayerId  String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  players             GlobalTotwPlayer[]
  competitionSeason   CompetitionSeason?  @relation(fields: [competitionSeasonId], references: [id], onDelete: SetNull)

  @@index([edition])
  @@index([isPublished])
}

model GlobalTotwPlayer {
  id                String              @id @default(cuid())
  globalTotwId      String
  playerId          String
  clubId            String
  leagueId          String?
  position          String              // "GK", "LB", "CB1", "CB2", "RB", "DMF", "CMF", "AMF", "LWF", "CF", "RWF"
  ratingBoost       Int                 @default(3)
  goalsInMatchday   Int                 @default(0)
  assistsInMatchday Int                 @default(0)
  isMotm            Boolean             @default(false)
  podiumRank        Int?                // 1 (1st MVP +3M), 2 (2nd Star +1.75M), 3 (3rd Star +1.5M), null
  createdAt         DateTime            @default(now())

  globalTotw        GlobalTeamOfTheWeek @relation(fields: [globalTotwId], references: [id], onDelete: Cascade)
  player            Player              @relation(fields: [playerId], references: [id])
  club              Club                @relation(fields: [clubId], references: [id])
  league            League?             @relation(fields: [leagueId], references: [id], onDelete: SetNull)

  @@unique([globalTotwId, position])
  @@index([globalTotwId])
  @@index([playerId])
  @@index([clubId])
  @@index([leagueId])
}

model ManagerPoll {
  id          String              @id @default(cuid())
  title       String
  description String?
  month       String              // e.g. "2026-08"
  isActive    Boolean             @default(true)
  expiresAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  options     ManagerPollOption[]
  votes       ManagerPollVote[]

  @@index([isActive])
}

model ManagerPollOption {
  id          String            @id @default(cuid())
  pollId      String
  managerId   String            // User ID
  clubName    String
  clubLogo    String?
  managerName String
  statement   String?
  voteCount   Int               @default(0)

  poll        ManagerPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes       ManagerPollVote[]

  @@index([pollId])
}

model ManagerPollVote {
  id        String            @id @default(cuid())
  pollId    String
  optionId  String
  userId    String            // User ID
  createdAt DateTime          @default(now())

  poll      ManagerPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    ManagerPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([userId])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum CupStage {
  ROUND_OF_16
  QUARTER_FINALS
  SEMI_FINALS
  FINAL
}

enum CupMatchStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

model ThroneCup {
  id                  String                  @id @default(cuid())
  competitionSeasonId String?
  leagueId            String                  // Specifically Botola Pro
  name                String                  @default("Throne Cup")
  season              String                  @default("2026/2027")
  status              CompetitionSeasonStatus @default(ACTIVE)
  championClubId      String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  matches             ThroneCupMatch[]
  championClub        Club?                   @relation("ThroneCupChampion", fields: [championClubId], references: [id])
  league              League                  @relation(fields: [leagueId], references: [id])

  @@index([leagueId])
  @@index([competitionSeasonId])
}

model ThroneCupMatch {
  id                  String              @id @default(cuid())
  cupId               String
  stage               CupStage            // ROUND_OF_16, QUARTER_FINALS, SEMI_FINALS, FINAL
  matchOrder          Int                 // 1..8 for R16, 1..4 for QF, 1..2 for SF, 1 for Final
  linkedMatchday      Int                 // 4 (for R16), 8 (for QF), 12 (for SF), 16 (for Final)
  homeClubId          String?
  awayClubId          String?
  winnerClubId        String?
  homeGoals           Int?
  awayGoals           Int?
  homePenalties       Int?
  awayPenalties       Int?
  isPenaltyShootout   Boolean             @default(false)
  status              CupMatchStatus      @default(UPCOMING)
  playedAt            DateTime?
  manOfTheMatchId     String?
  prizeAmount         Decimal             @default(0) @db.Decimal(14, 2)
  prizeAwarded        Boolean             @default(false)
  nextMatchOrder      Int?                // Target match in next round
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  cup                 ThroneCup           @relation(fields: [cupId], references: [id], onDelete: Cascade)
  homeClub            Club?               @relation("ThroneCupHomeMatches", fields: [homeClubId], references: [id])
  awayClub            Club?               @relation("ThroneCupAwayMatches", fields: [awayClubId], references: [id])
  winnerClub          Club?               @relation("ThroneCupWinnerMatches", fields: [winnerClubId], references: [id])
  manOfTheMatch       Player?             @relation("ThroneCupMotmMatches", fields: [manOfTheMatchId], references: [id])
  events              ThroneCupMatchEvent[]

  @@unique([cupId, stage, matchOrder])
  @@index([cupId])
  @@index([stage])
  @@index([status])
}

model ThroneCupMatchEvent {
  id             String          @id @default(cuid())
  matchId        String
  type           MatchEventType  // GOAL, ASSIST, YELLOW_CARD, RED_CARD, PENALTY
  clubId         String
  playerId       String
  assistPlayerId String?
  minute         Int?
  createdAt      DateTime        @default(now())

  match          ThroneCupMatch  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player         Player          @relation(fields: [playerId], references: [id])

  @@index([matchId])
  @@index([playerId])
}