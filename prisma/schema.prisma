generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                  @id @default(cuid())
  username              String                  @unique
  password              String
  role                  Role
  clubId                String?                 @unique
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  activityLogs          ActivityLog[]
  notifications         Notification[]
  transferWindowHistory TransferWindowHistory[]
  transfersInitiated    Transfer[]              @relation("TransferInitiatedBy")
  transfersResponded    Transfer[]              @relation("TransferRespondedBy")
  club                  Club?                   @relation("UserManagesClub", fields: [clubId], references: [id])

  @@index([role])
}

model CompetitionSeason {
  id        String                  @id @default(cuid())
  name      String                  @unique
  status    CompetitionSeasonStatus @default(DRAFT)
  format    MatchFormat             @default(DOUBLE_ROUND_ROBIN)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  seasons   Season[]
  matches   Match[]

  @@index([status])
}

model League {
  id        String   @id @default(cuid())
  name      String   @unique
  country   String
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clubs     Club[]
  seasons   Season[]
  matches   Match[]
}

model Club {
  id                                     String                  @id @default(cuid())
  name                                   String
  logo                                   String?
  leagueId                               String
  managerId                              String?                 @unique
  createdAt                              DateTime                @default(now())
  updatedAt                              DateTime                @updatedAt
  budget                                 Decimal                 @default(0) @db.Decimal(14, 2)

  league                                 League                  @relation(fields: [leagueId], references: [id])
  seasonClassifications                  SeasonClassification[]
  powerRating                            ClubPowerRating?
  budgetTransactions                     ClubBudgetTransaction[]
  players                                Player[]
  PlayerLoan_PlayerLoan_fromClubIdToClub PlayerLoan[]            @relation("PlayerLoan_fromClubIdToClub")
  PlayerLoan_PlayerLoan_toClubIdToClub   PlayerLoan[]            @relation("PlayerLoan_toClubIdToClub")
  transfersOut                           Transfer[]              @relation("TransferFromClub")
  transfersIn                            Transfer[]              @relation("TransferToClub")
  manager                                User?                   @relation("UserManagesClub")
  homeMatches                            Match[]                 @relation("HomeMatches")
  awayMatches                            Match[]                 @relation("AwayMatches")

  @@unique([name, leagueId])
  @@index([leagueId])
}

model Player {
  id                 String                  @id @default(uuid())
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  dateOfBirth        DateTime?
  fullName           String
  marketValue        Decimal?               @db.Decimal(12, 2)
  nationality        String
  overallRating      Int?
  photo              String?
  playerId           Int                     @unique @default(autoincrement())
  pmbClubId          String?
  position           String
  realClub           String
  status             PlayerStatus            @default(AVAILABLE)
  budgetTransactions ClubBudgetTransaction[]
  pmbClub            Club?                  @relation(fields: [pmbClubId], references: [id])
  PlayerLoan         PlayerLoan[]
  transfers          Transfer[]

  @@index([fullName])
  @@index([position])
  @@index([realClub])
  @@index([nationality])
  @@index([status])
  @@index([pmbClubId])
}

model Transfer {
  id                   String                  @id @default(uuid())
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  completedAt          DateTime?
  currency             String                  @default("EUR")
  fee                  Decimal?                @db.Decimal(12, 2)
  fromClubId           String
  fromClubName         String
  initiatedByUserId    String
  notes                String?
  playerId             String
  playerName           String
  respondedAt          DateTime?
  respondedByUserId    String?
  season               String
  status               TransferStatus          @default(PENDING_SELLER_APPROVAL)
  toClubId             String
  toClubName           String
  type                 TransferType            @default(PERMANENT)
  durationDays         Int?
  swapPlayerName       String?
  swapPlayerId   String?
  budgetTransactions   ClubBudgetTransaction[]
  notifications        Notification[]
  PlayerLoan           PlayerLoan?
  fromClub             Club                    @relation("TransferFromClub", fields: [fromClubId], references: [id])
  initiatedBy          User                    @relation("TransferInitiatedBy", fields: [initiatedByUserId], references: [id])
  player               Player                  @relation(fields: [playerId], references: [id])
  respondedBy          User?                   @relation("TransferRespondedBy", fields: [respondedByUserId], references: [id])
  toClub               Club                    @relation("TransferToClub", fields: [toClubId], references: [id])

  @@index([playerId])
  @@index([fromClubId])
  @@index([toClubId])
  @@index([status])
  @@index([playerId, status])
}

model Notification {
  id         String           @id @default(uuid())
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  message    String
  read       Boolean          @default(false)
  transferId String?
  type       NotificationType
  userId     String
  transfer   Transfer?        @relation(fields: [transferId], references: [id])
  user       User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, read])
  @@index([transferId])
}

model ActivityLog {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  action      String
  actorUserId String?
  entityId    String?
  entityType  String?
  metadata    Json?
  actor       User?    @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
}

model TransferWindow {
  id        String   @id @default("singleton")
  isOpen    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model TransferWindowHistory {
  id              String               @id @default(uuid())
  previousIsOpen  Boolean
  newIsOpen       Boolean
  action          TransferWindowAction
  changedByUserId String
  createdAt       DateTime             @default(now())
  changedBy       User                 @relation(fields: [changedByUserId], references: [id])

  @@index([createdAt])
  @@index([changedByUserId])
}

model ClubBudgetTransaction {
  id           String                @id @default(uuid())
  clubId       String
  amount       Decimal               @db.Decimal(14, 2)
  balanceAfter Decimal               @db.Decimal(14, 2)
  type         BudgetTransactionType
  description  String?
  transferId   String?
  playerId     String?
  createdAt    DateTime              @default(now())

  club         Club                  @relation(fields: [clubId], references: [id])
  player       Player?               @relation(fields: [playerId], references: [id])
  transfer     Transfer?             @relation(fields: [transferId], references: [id])

  @@index([clubId])
  @@index([clubId, createdAt])
  @@index([transferId])
}

model Season {
  id                  String                  @id @default(cuid())
  name                String
  leagueId            String
  startDate           DateTime?
  endDate             DateTime?
  status              SeasonStatus            @default(DRAFT)
  competitionSeasonId String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  league              League                  @relation(fields: [leagueId], references: [id])
  classifications     SeasonClassification[]
  competitionSeason   CompetitionSeason?      @relation(fields: [competitionSeasonId], references: [id])
  matches             Match[]

  @@unique([leagueId, name])
  @@index([leagueId])
  @@index([status])
  @@index([competitionSeasonId])
}

model SeasonClassification {
  id             String   @id @default(cuid())
  seasonId       String
  clubId         String
  position       Int
  points         Int?
  played         Int?
  wins           Int?
  draws          Int?
  losses         Int?
  goalDifference Int?
  goalsFor       Int?
  goalsAgainst   Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  season         Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  club           Club     @relation(fields: [clubId], references: [id])

  @@unique([seasonId, clubId])
  @@unique([seasonId, position])
  @@index([seasonId])
  @@index([clubId])
}

model PlayerLoan {
  id                               String     @id
  playerId                         String
  fromClubId                       String
  toClubId                         String
  transferId                       String     @unique
  startDate                        DateTime
  endDate                          DateTime
  status                           LoanStatus @default(ACTIVE)
  createdAt                        DateTime   @default(now())
  updatedAt                        DateTime
  durationDays                     Int        @default(40)

  Club_PlayerLoan_fromClubIdToClub Club       @relation("PlayerLoan_fromClubIdToClub", fields: [fromClubId], references: [id])
  Player                           Player     @relation(fields: [playerId], references: [id])
  Club_PlayerLoan_toClubIdToClub   Club       @relation("PlayerLoan_toClubIdToClub", fields: [toClubId], references: [id])
  Transfer                         Transfer   @relation(fields: [transferId], references: [id])

  @@index([endDate])
  @@index([fromClubId])
  @@index([playerId])
  @@index([status])
  @@index([toClubId])
}
model Match {
  id                  String      @id @default(cuid())
  competitionSeasonId String
  seasonId            String
  leagueId            String
  matchday            Int
  homeClubId          String
  awayClubId          String
  homeGoals           Int?
  awayGoals           Int?
  status              MatchStatus @default(UPCOMING)
  playedAt            DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  competitionSeason CompetitionSeason @relation(fields: [competitionSeasonId], references: [id])
  season            Season            @relation(fields: [seasonId], references: [id])
  league            League            @relation(fields: [leagueId], references: [id])
  homeClub          Club              @relation("HomeMatches", fields: [homeClubId], references: [id])
  awayClub          Club              @relation("AwayMatches", fields: [awayClubId], references: [id])

  @@index([competitionSeasonId])
  @@index([seasonId])
  @@index([leagueId])
  @@index([homeClubId])
  @@index([awayClubId])
  @@index([status])
  @@index([matchday])
  @@index([seasonId, matchday])
}

model ClubPowerRating {
  id            String   @id @default(cuid())
  clubId        String   @unique
  rating        Int      @default(1000)
  seasonsPlayed Int      @default(0)
  titles        Int      @default(0)
  topThree      Int      @default(0)
  topFive       Int      @default(0)
  updatedAt     DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id])

  @@index([rating])
}
enum Role {
  ADMINISTRATOR
  CLUB_MANAGER
}

enum PlayerStatus {
  AVAILABLE
  REGISTERED
}

enum TransferStatus {
  PENDING_SELLER_APPROVAL
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum TransferType {
  PERMANENT
  LOAN
  SWAP
  FREE_TRANSFER
}

enum TransferWindowAction {
  OPENED
  CLOSED
}

enum NotificationType {
  TRANSFER_REQUESTED
  TRANSFER_ACCEPTED
  TRANSFER_REJECTED
  TRANSFER_CANCELLED
  TRANSFER_COMPLETED
  TRANSFER_WINDOW_OPENED
  TRANSFER_WINDOW_CLOSED
}

enum BudgetTransactionType {
  TRANSFER_IN
  TRANSFER_OUT
  ADMIN_ADJUSTMENT
}

enum LoanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SeasonStatus {
  DRAFT
  ACTIVE
  FINISHED
}

enum CompetitionSeasonStatus {
  DRAFT
  ACTIVE
  FINISHED
}

enum MatchFormat {
  SINGLE_ROUND_ROBIN
  DOUBLE_ROUND_ROBIN
}

enum MatchStatus {
  UPCOMING
  COMPLETED
}